rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================== */

    function loggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return loggedIn() && request.auth.token.email == 'sathyamanojbiyyapu@gmail.com';
    }

    function validString(field) {
      return field is string && field.size() > 0;
    }

    function validNumber(field) {
      return field is number;
    }

    function validList(field) {
      return field is list;
    }

    // Get the user's phone from auth token (phone_number claim) or fallback
    function myPhone() {
      return request.auth.token.phone_number != null
        ? request.auth.token.phone_number.replace('+91', '')
        : null;
    }

    // Check if the request is for the authenticated user's own document.
    // Accepts all equivalent own-phone forms: 10-digit, +91-prefixed, or the
    // Firebase Auth UID. Never grants access to another user's document.
    function isOwnDoc(phone) {
      return loggedIn() && (
        phone == myPhone() ||
        phone == request.auth.token.phone_number ||
        phone == request.auth.uid
      );
    }

    /* =========================
       USER PROFILES
       Document ID: phone number
       - get (single doc fetch): only your OWN profile (or admin).
       - list (collection queries): any logged-in user — required for
         partner matching on /dashboard and /find-partners.
    ========================== */

    match /users/{phone} {
      allow get: if loggedIn() && (isOwnDoc(phone) || isAdmin());
      allow list: if loggedIn();
      allow create: if loggedIn() && isOwnDoc(phone) && validString(request.resource.data.phone);
      allow update: if loggedIn() && isOwnDoc(phone);
      allow delete: if false;
    }

    /* =========================
       CATEGORY SYSTEM (public read)
    ========================== */

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
      match /subcategories/{subId} {
        allow read: if true;
        allow write: if false;
      }
    }

    /* =========================
       MARKETPLACE (SCOPE-BASED)
       Path: marketplace/{categorySlug}/businesses/{businessId}
       Read: any logged-in user (public marketplace)
       Write: admin only
    ========================== */

    match /marketplace/{categorySlug}/businesses/{businessId} {
      allow read: if loggedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       USER SELECTIONS
       Users can only read/write their OWN selections.
    ========================== */

    match /selections/{docId} {
      // Single-doc fetch: only your OWN selection (or admin).
      allow get: if loggedIn() && (isOwnDoc(resource.data.phone) || isOwnDoc(resource.data.uid) || isAdmin());
      // Collection list: any logged-in user — required for /dashboard My Matches,
      // which loads all selections to build the partner map. Mirrors /users.
      // (NOTE: read rules cannot use request.resource — that only exists for
      // write requests; using it in a read rule denies everyone.)
      allow list: if loggedIn();
      allow create: if loggedIn() && validString(request.resource.data.uid) && validString(request.resource.data.phone) && validString(request.resource.data.category) && (isOwnDoc(request.resource.data.phone) || isOwnDoc(request.resource.data.uid));
      allow update: if loggedIn() && (isOwnDoc(resource.data.phone) || isOwnDoc(resource.data.uid) || isAdmin());
      allow delete: if false;
    }

    /* =========================
       GROUP MATCHING
       Read: any logged-in user (needed for matching)
       Create: logged-in user
       Update: admin only (prevents membership manipulation)
    ========================== */

    match /groups/{groupId} {
      allow read: if loggedIn();
      allow create: if loggedIn() && validString(request.resource.data.category) && validString(request.resource.data.option) && validNumber(request.resource.data.membersCount) && validNumber(request.resource.data.requiredSize) && validList(request.resource.data.members) && validList(request.resource.data.memberUIDs) && validString(request.resource.data.createdBy) && request.resource.data.membersCount >= 1 && request.resource.data.requiredSize >= 2;
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       MATCH REQUESTS
       Users can read their own requests; admin can read all.
    ========================== */

    match /matchRequests/{docId} {
      allow read: if loggedIn() && (isOwnDoc(resource.data.userA.phone) || isOwnDoc(resource.data.userB.phone) || isAdmin());
      allow create: if loggedIn() && request.resource.data.userA is map && request.resource.data.userB is map && validString(request.resource.data.userA.phone) && validString(request.resource.data.userB.phone) && validString(request.resource.data.status) && (isOwnDoc(request.resource.data.userA.phone) || isOwnDoc(request.resource.data.userB.phone));
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       PAYMENTS
       Users can read their OWN payments only.
       Create: logged-in user (own payment)
       Update: admin only (prevents client-side payment manipulation)
    ========================== */

    match /payments/{paymentId} {
      allow read: if loggedIn() && (isOwnDoc(resource.data.uid) || isOwnDoc(resource.data.phone) || isAdmin());
      allow create: if loggedIn() && validString(request.resource.data.uid) && validNumber(request.resource.data.amount) && (isOwnDoc(request.resource.data.uid) || isOwnDoc(request.resource.data.phone));
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       CHAT SYSTEM
       Users can only read/write chats they are members of.
    ========================== */

    match /chats/{chatId} {
      allow read: if loggedIn() && (resource.data.memberUIDs != null && (resource.data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));
      allow create: if loggedIn() && validList(request.resource.data.memberUIDs);
      allow update: if loggedIn() && (resource.data.memberUIDs != null && (resource.data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if loggedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));
        allow create: if loggedIn() && validString(request.resource.data.senderId) && validString(request.resource.data.text) && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));
        allow update: if false;
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if loggedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));
        allow write: if loggedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));
      }
    }

    /* =========================
       ONLINE STATUS
       Users can only write their OWN status.
    ========================== */

    match /status/{uid} {
      allow read: if loggedIn();
      allow write: if loggedIn() && (uid == request.auth.uid || uid == myPhone());
    }

    /* =========================
       MOVIE TICKETS
       Read: logged-in users
       Create: logged-in user
       Update: admin only
    ========================== */

    match /movieTickets/{ticketId} {
      allow read: if loggedIn();
      allow create: if loggedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       TICKET REQUESTS
       Read: admin only (contains buyer phone)
       Create: logged-in user
    ========================== */

    match /ticketRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if loggedIn();
      allow update: if false;
      allow delete: if false;
    }

    /* =========================
       COLLABORATORS
       Read: logged-in users
       Create: logged-in user
       Update: admin only
    ========================== */

    match /collaborators/{docId} {
      allow read: if loggedIn();
      allow create: if loggedIn() && validString(request.resource.data.category) && validString(request.resource.data.subcategory) && validString(request.resource.data.option) && validString(request.resource.data.state) && validString(request.resource.data.district) && validString(request.resource.data.city) && validString(request.resource.data.phone) && (request.resource.data.status in ["pending", "approved", "rejected", "featured", "hidden"]);
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       REPORTS
       Create: logged-in user
       Read: admin only
    ========================== */

    match /reports/{docId} {
      allow read: if isAdmin();
      allow create: if loggedIn();
      allow update: if false;
      allow delete: if false;
    }

    /* =========================
       USER COLLABORATIONS
       Read: admin only (contains user contact info)
       Create: logged-in user
       Update: admin only
    ========================== */

    match /userCollaborations/{docId} {
      allow read: if isAdmin();
      // Submissions are created by the SERVER route /api/submit-gym (which runs
      // duplicate checks + pending workflow) — the client cannot write here, so
      // duplicates can't bypass the approval queue.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       NOTIFICATIONS
       Users can only read/write their OWN notifications.
    ========================== */

    match /notifications/{notificationId} {
      allow read: if loggedIn() && (isOwnDoc(resource.data.uid) || isAdmin());
      allow create: if loggedIn() && (isOwnDoc(request.resource.data.uid) || isAdmin());
      allow update: if loggedIn() && (isOwnDoc(resource.data.uid) || isAdmin());
      allow delete: if false;
    }

    /* =========================
       GYM SUBMISSIONS
       Read: admin only
       Create: logged-in user
       Update: admin only
    ========================== */

    match /gymSubmissions/{docId} {
      allow read: if isAdmin();
      allow create: if loggedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       PENDING BUSINESSES
       Read: admin only
       Create: logged-in user
       Update: admin only
    ========================== */

    match /pendingBusinesses/{docId} {
      allow read: if isAdmin();
      allow create: if loggedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* =========================
       FALLBACK: DENY ALL UNMATCHED COLLECTIONS
    ========================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}