[debug] [2026-08-28T10:49:53.261Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/splitpartnering/rulesets {"name":"projects/splitpartnering/rulesets/85f13a4b-dbfa-4564-88ca-41fa4d848a62","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n\r\n  match /databases/{database}/documents {\r\n\r\n    /* =========================\r\n       HELPERS\r\n    ========================== */\r\n\r\n    function loggedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return loggedIn() && request.auth.token.email == 'sathyamanojbiyyapu@gmail.com';\r\n    }\r\n\r\n    function validString(field) {\r\n      return field is string && field.size() > 0;\r\n    }\r\n\r\n    function validNumber(field) {\r\n      return field is number;\r\n    }\r\n\r\n    function validList(field) {\r\n      return field is list;\r\n    }\r\n\r\n    // Get the user's phone from auth token (phone_number claim) or fallback\r\n    function myPhone() {\r\n      return request.auth.token.phone_number != null\r\n        ? request.auth.token.phone_number.replace('+91', '')\r\n        : null;\r\n    }\r\n\r\n    // Check if the request is for the authenticated user's own document\r\n    function isOwnDoc(phone) {\r\n      return loggedIn() && (phone == myPhone() || phone == request.auth.uid);\r\n    }\r\n\r\n    /* =========================\r\n       USER PROFILES\r\n       Document ID: phone number\r\n       - get (single doc fetch): only your OWN profile (or admin).\r\n       - list (collection queries): any logged-in user — required for\r\n         partner matching on /dashboard and /find-partners.\r\n    ========================== */\r\n\r\n    match /users/{phone} {\r\n      allow get: if loggedIn() && (isOwnDoc(phone) || isAdmin());\r\n      allow list: if loggedIn();\r\n      allow create: if loggedIn() && isOwnDoc(phone) && validString(request.resource.data.phone);\r\n      allow update: if loggedIn() && isOwnDoc(phone);\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       CATEGORY SYSTEM (public read)\r\n    ========================== */\r\n\r\n    match /categories/{categoryId} {\r\n      allow read: if true;\r\n      allow write: if false;\r\n      match /subcategories/{subId} {\r\n        allow read: if true;\r\n        allow write: if false;\r\n      }\r\n    }\r\n\r\n    /* =========================\r\n       MARKETPLACE (SCOPE-BASED)\r\n       Path: marketplace/{categorySlug}/businesses/{businessId}\r\n       Read: any logged-in user (public marketplace)\r\n       Write: admin only\r\n    ========================== */\r\n\r\n    match /marketplace/{categorySlug}/businesses/{businessId} {\r\n      allow read: if loggedIn();\r\n      allow create: if isAdmin();\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       USER SELECTIONS\r\n       Users can only read/write their OWN selections.\r\n    ========================== */\r\n\r\n    match /selections/{docId} {\r\n      allow read: if loggedIn() && (request.resource == null || isOwnDoc(request.resource.data.phone) || isOwnDoc(request.resource.data.uid) || isAdmin());\r\n      allow create: if loggedIn() && validString(request.resource.data.uid) && validString(request.resource.data.phone) && validString(request.resource.data.category) && (isOwnDoc(request.resource.data.phone) || isOwnDoc(request.resource.data.uid));\r\n      allow update: if loggedIn() && (isOwnDoc(resource.data.phone) || isOwnDoc(resource.data.uid) || isAdmin());\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       GROUP MATCHING\r\n       Read: any logged-in user (needed for matching)\r\n       Create: logged-in user\r\n       Update: admin only (prevents membership manipulation)\r\n    ========================== */\r\n\r\n    match /groups/{groupId} {\r\n      allow read: if loggedIn();\r\n      allow create: if loggedIn() && validString(request.resource.data.category) && validString(request.resource.data.option) && validNumber(request.resource.data.membersCount) && validNumber(request.resource.data.requiredSize) && validList(request.resource.data.members) && validList(request.resource.data.memberUIDs) && validString(request.resource.data.createdBy) && request.resource.data.membersCount >= 1 && request.resource.data.requiredSize >= 2;\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       MATCH REQUESTS\r\n       Users can read their own requests; admin can read all.\r\n    ========================== */\r\n\r\n    match /matchRequests/{docId} {\r\n      allow read: if loggedIn() && (isOwnDoc(resource.data.userA.phone) || isOwnDoc(resource.data.userB.phone) || isAdmin());\r\n      allow create: if loggedIn() && request.resource.data.userA is map && request.resource.data.userB is map && validString(request.resource.data.userA.phone) && validString(request.resource.data.userB.phone) && validString(request.resource.data.status) && (isOwnDoc(request.resource.data.userA.phone) || isOwnDoc(request.resource.data.userB.phone));\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       PAYMENTS\r\n       Users can read their OWN payments only.\r\n       Create: logged-in user (own payment)\r\n       Update: admin only (prevents client-side payment manipulation)\r\n    ========================== */\r\n\r\n    match /payments/{paymentId} {\r\n      allow read: if loggedIn() && (isOwnDoc(resource.data.uid) || isOwnDoc(resource.data.phone) || isAdmin());\r\n      allow create: if loggedIn() && validString(request.resource.data.uid) && validNumber(request.resource.data.amount) && (isOwnDoc(request.resource.data.uid) || isOwnDoc(request.resource.data.phone));\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       CHAT SYSTEM\r\n       Users can only read/write chats they are members of.\r\n    ========================== */\r\n\r\n    match /chats/{chatId} {\r\n      allow read: if loggedIn() && (resource.data.memberUIDs != null && (resource.data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));\r\n      allow create: if loggedIn() && validList(request.resource.data.memberUIDs);\r\n      allow update: if loggedIn() && (resource.data.memberUIDs != null && (resource.data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));\r\n      allow delete: if false;\r\n\r\n      match /messages/{messageId} {\r\n        allow read: if loggedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));\r\n        allow create: if loggedIn() && validString(request.resource.data.senderId) && validString(request.resource.data.text) && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));\r\n        allow update: if false;\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /typing/{uid} {\r\n        allow read: if loggedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));\r\n        allow write: if loggedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.memberUIDs.hasAny([request.auth.uid, myPhone()]) || isAdmin()));\r\n      }\r\n    }\r\n\r\n    /* =========================\r\n       ONLINE STATUS\r\n       Users can only write their OWN status.\r\n    ========================== */\r\n\r\n    match /status/{uid} {\r\n      allow read: if loggedIn();\r\n      allow write: if loggedIn() && (uid == request.auth.uid || uid == myPhone());\r\n    }\r\n\r\n    /* =========================\r\n       MOVIE TICKETS\r\n       Read: logged-in users\r\n       Create: logged-in user\r\n       Update: admin only\r\n    ========================== */\r\n\r\n    match /movieTickets/{ticketId} {\r\n      allow read: if loggedIn();\r\n      allow create: if loggedIn();\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       TICKET REQUESTS\r\n       Read: admin only (contains buyer phone)\r\n       Create: logged-in user\r\n    ========================== */\r\n\r\n    match /ticketRequests/{requestId} {\r\n      allow read: if isAdmin();\r\n      allow create: if loggedIn();\r\n      allow update: if false;\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       COLLABORATORS\r\n       Read: logged-in users\r\n       Create: logged-in user\r\n       Update: admin only\r\n    ========================== */\r\n\r\n    match /collaborators/{docId} {\r\n      allow read: if loggedIn();\r\n      allow create: if loggedIn() && validString(request.resource.data.category) && validString(request.resource.data.subcategory) && validString(request.resource.data.option) && validString(request.resource.data.state) && validString(request.resource.data.district) && validString(request.resource.data.city) && validString(request.resource.data.phone) && (request.resource.data.status in [\"pending\", \"approved\", \"rejected\", \"featured\", \"hidden\"]);\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       REPORTS\r\n       Create: logged-in user\r\n       Read: admin only\r\n    ========================== */\r\n\r\n    match /reports/{docId} {\r\n      allow read: if isAdmin();\r\n      allow create: if loggedIn();\r\n      allow update: if false;\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       USER COLLABORATIONS\r\n       Read: admin only (contains user contact info)\r\n       Create: logged-in user\r\n       Update: admin only\r\n    ========================== */\r\n\r\n    match /userCollaborations/{docId} {\r\n      allow read: if isAdmin();\r\n      allow create: if loggedIn() && validString(request.resource.data.businessName) && validString(request.resource.data.category) && validString(request.resource.data.state) && validString(request.resource.data.district) && validString(request.resource.data.city) && validString(request.resource.data.createdBy) && validString(request.resource.data.createdByName) && validString(request.resource.data.createdByPhone) && request.resource.data.status == \"pending\";\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       NOTIFICATIONS\r\n       Users can only read/write their OWN notifications.\r\n    ========================== */\r\n\r\n    match /notifications/{notificationId} {\r\n      allow read: if loggedIn() && (isOwnDoc(resource.data.uid) || isAdmin());\r\n      allow create: if loggedIn() && (isOwnDoc(request.resource.data.uid) || isAdmin());\r\n      allow update: if loggedIn() && (isOwnDoc(resource.data.uid) || isAdmin());\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       GYM SUBMISSIONS\r\n       Read: admin only\r\n       Create: logged-in user\r\n       Update: admin only\r\n    ========================== */\r\n\r\n    match /gymSubmissions/{docId} {\r\n      allow read: if isAdmin();\r\n      allow create: if loggedIn();\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       PENDING BUSINESSES\r\n       Read: admin only\r\n       Create: logged-in user\r\n       Update: admin only\r\n    ========================== */\r\n\r\n    match /pendingBusinesses/{docId} {\r\n      allow read: if isAdmin();\r\n      allow create: if loggedIn();\r\n      allow update: if isAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* =========================\r\n       FALLBACK: DENY ALL UNMATCHED COLLECTIONS\r\n    ========================== */\r\n\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}","name":"firestore.rules"}]},"createTime":"2026-08-28T10:49:53.116223Z","metadata":{"services":["cloud.firestore"]}}
